# macOS / Finder
.DS_Store
.AppleDouble
*.swp
Icon?
._*
Desktop.ini

# Build artifacts (regenerated by build.sh / make-dmg.sh / publish-update.sh)
build/
dist/
*.dmg

# Node — workspace dependencies and plugin build outputs (tsc lib emit)
