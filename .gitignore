# committed so installs are reproducible)
node_modules/
lib/
**/lib/
*.tsbuildinfo
coverage/
scripts/.tmp-*
npm-debug.log*
pnpm-debug.log

# Runtime data (agent sessions, sqlite indexes, …)
.data/
settings.yaml
.credentials.yaml

# Editors / IDEs
.idea/
.vscode/
*.xcuserstate
xcuserdata/
