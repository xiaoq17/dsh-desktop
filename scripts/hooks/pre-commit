#!/bin/bash
# Repository hygiene gate (pre-commit) — mirrors the harness family convention.
#
# Enforces byte-level hygiene on staged text files:
#   * no whitespace errors (`git diff --cached --check`)
#   * every staged text file ends with exactly one trailing newline
#   * no CRLF line endings in the working tree (LF is canonical via .gitattributes)
#
# It deliberately does NOT enforce the Agent-Note rule — that is enforced by
# code review (see AGENTS.md "Code-change gate").
#
# Install:  ./scripts/install-hooks.sh
# The ByteDance bytesec security hook (global core.hooksPath) already chains to
# this repo's .git/hooks/pre-commit, so both run — nothing is overwritten.
set -euo pipefail

REPO="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$REPO" ] || exit 0

# Staged files (tracked, non-deleted). while-read keeps this bash-3.2
# compatible (macOS /bin/bash has no mapfile).
staged=()
while IFS= read -r f; do
  staged+=("$f")
done < <(git -C "$REPO" diff --cached --name-only --diff-filter=ACMR)

violations=0

# 1. Whitespace errors (trailing spaces, space-before-tab, blank-at-eof).
if ! git -C "$REPO" diff --cached --check; then
  echo "[hygiene] ⛔ whitespace errors in staged changes (see above)." >&2
  violations=$((violations + 1))
fi

# 2. Trailing-newline / CRLF check on staged text files.
for f in "${staged[@]}"; do
  path="$REPO/$f"
  [ -f "$path" ] || continue
  # Skip files git treats as binary (NUL byte present).
  if grep -q $'\x00' "$path" 2>/dev/null; then
    continue
  fi
  if grep -q $'\r' "$path" 2>/dev/null; then
    echo "[hygiene] ⛔ CRLF in $f (LF is canonical; see .gitattributes)." >&2
    violations=$((violations + 1))
  fi
  # Last byte must be a single LF (0x0a) — one trailing newline.
  last_byte="$(tail -c 1 "$path" | od -An -t x1 | tr -d ' \n')"
  if [ -n "$last_byte" ] && [ "$last_byte" != "0a" ]; then
    echo "[hygiene] ⛔ $f does not end with a trailing newline." >&2
    violations=$((violations + 1))
  fi
done

if [ "$violations" -gt 0 ]; then
  echo "[hygiene] fix the issues above, then re-stage and commit." >&2
  exit 1
fi

echo "[hygiene] ✓ staged changes pass the byte-level hygiene gate." >&2
exit 0
